# ==============================================================================
# Smart Bike Backend - Environment Variables Template / Mẫu Biến Môi Trường
# ==============================================================================
# Copy this file to .env to customize your configuration:
# Sao chép file này thành .env để tùy chỉnh cấu hình:
#
#   cp .env.example .env
# ==============================================================================

# Project Name / Tên dự án
PROJECT_NAME="Smart Bike Backend"

# API Route Prefix / Tiền tố đường dẫn API
API_V1_STR="/api/v1"

# OSRM Routing Engine URL (Docker container) / Địa chỉ máy chủ định tuyến OSRM
OSRM_BASE_URL="http://localhost:5000"

# Default Routing Profile: 'driving' (recommended to enforce one-way rules) or 'biking'
# Profile định tuyến mặc định: 'driving' (khuyên dùng để tuân thủ đường 1 chiều) hoặc 'biking'
DEFAULT_ROUTING_PROFILE="driving"

# OSRM HTTP Request Timeout in seconds / Thời gian chờ tối đa khi gọi OSRM (giây)
OSRM_TIMEOUT_SECONDS=5.0

# In-Memory LRU Map Tile Cache Size / Kích thước bộ nhớ đệm (LRU cache) lưu tile bản đồ trong RAM
TILE_CACHE_MAXSIZE=512

# OpenStreetMap User-Agent Header / Header User-Agent khi tải tile từ OpenStreetMap
TILE_USER_AGENT="SmartBikeBackend/1.0"
