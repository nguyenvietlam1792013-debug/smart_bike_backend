# ==============================================================================
# Smart Bike Backend - Environment Variables Template
# ==============================================================================
# Sao chép file này thành .env để tùy chỉnh môi trường:
# cp .env.example .env

PROJECT_NAME="Smart Bike Backend"
API_V1_STR="/api/v1"

# URL của máy chủ OSRM routing engine (Docker container)
OSRM_BASE_URL="http://localhost:5000"

# Profile định tuyến mặc định: 'driving' (khuyên dùng để tuân thủ đường 1 chiều) hoặc 'biking'
DEFAULT_ROUTING_PROFILE="driving"

# Thời gian chờ tối đa khi gọi OSRM (giây)
OSRM_TIMEOUT_SECONDS=5.0

# Kích thước bộ nhớ đệm (LRU cache) lưu trữ map tile trong RAM
TILE_CACHE_MAXSIZE=512

# User-Agent khi tải tile từ OpenStreetMap
TILE_USER_AGENT="SmartBikeBackend/1.0"
